# Database connection (PostgreSQL only - NEVER exposed to Flutter)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_os

# Server Configuration
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Security & Authentication
# IMPORT_API_KEY protects the /api/v1/import/* endpoints (Server-to-Server ingestion)
IMPORT_API_KEY=replace_with_secure_import_api_key
JWT_SECRET=replace_with_secure_jwt_secret

# CORS
CORS_ORIGINS=*

# --- Hourly live-job sync ------------------------------------------------------------------
# Protects POST /api/v1/internal/jobs/sync and GET /api/v1/internal/jobs/sync/status.
# Min 24 chars. Generate locally with `npm run jobs:setup` (writes backend/.env), or:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset => the internal endpoints answer 503 (fail closed). Never commit a real value.
JOB_SYNC_SECRET=

# Optional tuning (defaults shown). Board/org lists are comma-separated ATS slugs.
# JOB_SYNC_PROVIDERS=greenhouse,lever,ashby,remoteok,weworkremotely
# JOB_SYNC_GREENHOUSE_BOARDS=airbnb,stripe,figma,cloudflare,databricks,gusto,discord,gitlab,coinbase,vercel,datadog,reddit
# JOB_SYNC_LEVER_ORGS=palantir,spotify,shieldai
# JOB_SYNC_ASHBY_ORGS=ramp,linear,supabase,notion,vanta
# JOB_SYNC_MIN_MATCH_SCORE=45        # 0-100; below this a job is rejected
# JOB_SYNC_MAX_YEARS=2               # highest minimum-years requirement still accepted
# JOB_SYNC_ALLOW_INTERNSHIPS=false
# JOB_SYNC_STALE_AFTER_HOURS=48      # OPEN -> STALE when not seen this long
# JOB_SYNC_CLOSE_AFTER_DAYS=14       # STALE -> CLOSED
# JOB_SYNC_TIMEOUT_MS=15000          # per HTTP request
# JOB_SYNC_MAX_RETRIES=3             # transient failures only (timeout, 429, 5xx)
# JOB_SYNC_PROVIDER_TIMEOUT_MS=120000
# JOB_SYNC_LOCK_TTL_SECONDS=900
# JOB_SYNC_PROFILE_PATH=             # optional JSON file overriding the candidate profile
