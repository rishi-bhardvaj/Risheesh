{
  "name": "career-os-backend",
  "version": "1.0.0",
  "description": "PostgreSQL backend & JSON ingestion API for Career OS",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx scripts/run-migrations.ts",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "import:jobs": "tsx scripts/import-daily-data.ts jobs",
    "import:freelance": "tsx scripts/import-daily-data.ts freelance",
    "migrate:sqlite": "tsx scripts/migrate_sqlite_to_postgres.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
